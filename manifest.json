  "aqtinstall": {
    "comment": "Installs Qt and its tools without a Qt account. Pinned to a commit: Qt 6.11 changed its repository layout and no release since 3.3.0 reads it (docs/decisions/0002).",
    "requirement": "aqtinstall @ https://github.com/miurahr/aqtinstall/archive/076e1659807d0b362a3ed684d54c2e9c775eb9c7.zip",
    "version": "3.3.1.dev166",
    "version_comment": "A source zip has no git history, so the version aqtinstall would read from git is given here (SETUPTOOLS_SCM_PRETEND_VERSION). No git needed on the machine."
  },
